<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_marker">
    <static>true</static>
    <link name="marker_link">
      <pose>0 0 0 0 0 0</pose>
      
      <visual name="visual">
        <geometry>
          <box>
            <size>0.001 0.1524 0.1524</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://aruco_marker/materials/textures/aruco_0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      
      <!-- Thin collision for the marker -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.001 0.1524 0.1524</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
