<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rc_ackermann_vehicle">
    
    <!-- Chassis -->
    <link name="chassis">
      <pose>0 0 0.04 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.013</ixx>
          <iyy>0.027</iyy>
          <izz>0.033</izz>
        </inertia>
      </inertial>
      
      <collision name="collision">
        <geometry>
          <box>
            <size>0.4 0.2 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>
    
    <!-- Middle Chassis -->
    <link name="chassis_middle">
      <pose>0 0 0.04 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.006</ixx>
          <iyy>0.013</iyy>
          <izz>0.016</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.18 0.13 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.18 0.13 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.4 1.0 1</ambient>
          <diffuse>0.3 0.5 1.0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Front Chassis -->
    <link name="chassis_front">
      <pose>0.11 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.004</iyy>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.11 0.08 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.11 0.08 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.4 1.0 1</ambient>
          <diffuse>0.3 0.5 1.0 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Back Chassis -->
    <link name="chassis_back">
      <pose>-0.115 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.004</iyy>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.11 0.08 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.11 0.08 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.4 1.0 1</ambient>
          <diffuse>0.3 0.5 1.0 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Rear Right Wheel -->
    <link name="rear_right_wheel">
      <pose>-0.127 -0.08255 0.03 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00027</ixx>
          <iyy>0.00027</iyy>
          <izz>0.00027</izz>
        </inertia>
      </inertial>
      
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Rear Left Wheel -->
    <link name="rear_left_wheel">
      <pose>-0.127 0.08255 0.03 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00027</ixx>
          <iyy>0.00027</iyy>
          <izz>0.00027</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Front Left Wheel -->
    <link name="front_left_wheel">
      <pose relative_to="front_left_steer">0 0 -0.01 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00027</ixx>
          <iyy>0.00027</iyy>
          <izz>0.00027</izz>
        </inertia>
      </inertial>
      
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Front Right Wheel -->
    <link name="front_right_wheel">
      <pose relative_to="front_right_steer">0 0 -0.01 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00027</ixx>
          <iyy>0.00027</iyy>
          <izz>0.00027</izz>
        </inertia>
      </inertial>
      
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.033</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
    
    <!-- Front Left Steering Knuckle -->
    <link name="front_left_steer">
      <pose>0.127 0.08255 0.04 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>
    
    <!-- Front Right Steering Knuckle -->
    <link name="front_right_steer">
      <pose>0.127 -0.08255 0.04 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>
    
    <!-- Rear Left Wheel Joint -->
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz expressed_in="rear_left_wheel">0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Rear Right Wheel Joint -->
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz expressed_in="rear_right_wheel">0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Front Left Steering Joint -->
    <joint name="front_left_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steer</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>1e6</effort>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Front Right Steering Joint -->
    <joint name="front_right_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steer</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>1e6</effort>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Front Left Wheel Joint -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz expressed_in="front_left_wheel">0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Front Right Wheel Joint -->
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz expressed_in="front_right_wheel">0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>
    
    <!-- Ackermann Steering Plugin -->
    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <wheel_base>0.254</wheel_base>
      <wheel_separation>0.14</wheel_separation>
      <kingpin_width>0.14</kingpin_width>
      <steering_limit>0.786</steering_limit>
      <wheel_radius>0.033</wheel_radius>
      <min_velocity>-2.0</min_velocity>
      <max_velocity>2.0</max_velocity>
      <min_acceleration>-5.0</min_acceleration>
      <max_acceleration>5.0</max_acceleration>
      <topic>/model/rc_ackermann_vehicle/cmd_vel</topic>
      <odometry_topic>/model/rc_ackermann_vehicle/odom</odometry_topic>
    </plugin>

    <!-- Joint State Publisher Plugin -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>front_left_steer_joint</joint_name>
      <joint_name>front_right_steer_joint</joint_name>
      <topic>/model/rc_ackermann_vehicle/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
    
    <!-- Rear Axle Center Link -->
    <link name="rear_axle_center">
      <pose relative_to="chassis">-0.127 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="rear_axle_center_joint" type="fixed">
      <parent>chassis</parent>
      <child>rear_axle_center</child>
    </joint>

    <!-- Connect chassis parts together -->
    <joint name="chassis_middle_joint" type="fixed">
      <parent>chassis</parent>
      <child>chassis_middle</child>
    </joint>

    <joint name="chassis_front_joint" type="fixed">
      <parent>chassis</parent>
      <child>chassis_front</child>
    </joint>

    <joint name="chassis_back_joint" type="fixed">
      <parent>chassis</parent>
      <child>chassis_back</child>
    </joint>

    <!-- IMU Sensor at chassis center -->
    <link name="imu_link">
      <pose relative_to="chassis">-0.002 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.009</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.009</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.009</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <topic>/model/rc_ackermann_vehicle/imu</topic>
      </sensor>
    </link>
    
    <joint name="imu_joint" type="fixed">
      <parent>chassis</parent>
      <child>imu_link</child>
    </joint>
    
    <!-- RGBD Camera (similar to OAK-D Lite) -->
    <link name="camera_link">
      <pose relative_to="rear_axle_center">0.14 0 0.05 0 0.09 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.03 0.05 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      
      <!-- RGB Camera -->
      <sensor name="rgbd_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
      </sensor>
    </link>
    
    <joint name="camera_joint" type="fixed">
      <parent>chassis</parent>
      <child>camera_link</child>
    </joint>
    
  </model>
</sdf>