<?xml version="1.0"?><sdf version="1.9"><model name="oak_d_lite">
<link name="oak">
<inertial><mass>0.0579</mass><inertia><ixx>0.000044</ixx><iyy>0.0000055</iyy><izz>0.000042</izz></inertia></inertial>
      <visual name="housing">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://oak_d_lite/meshes/housing.dae</uri></mesh></geometry>
        <material><ambient>0.88 0.89 0.85 1</ambient><diffuse>0.88 0.89 0.85 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
      </visual>
      <visual name="face">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://oak_d_lite/meshes/face.dae</uri></mesh></geometry>
        <material><ambient>0.018 0.021 0.025 1</ambient><diffuse>0.018 0.021 0.025 1</diffuse><specular>0.18 0.18 0.18 1</specular></material>
      </visual>
      <visual name="lens_rings">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://oak_d_lite/meshes/lens_rings.dae</uri></mesh></geometry>
        <material><ambient>0.032 0.036 0.043 1</ambient><diffuse>0.032 0.036 0.043 1</diffuse><specular>0.42 0.42 0.42 1</specular></material>
      </visual>
      <visual name="lenses">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://oak_d_lite/meshes/lenses.dae</uri></mesh></geometry>
        <material><ambient>0.008 0.016 0.028 1</ambient><diffuse>0.008 0.016 0.028 1</diffuse><specular>0.75 0.75 0.75 1</specular></material>
      </visual>
    </link>
<link name="oak_rgb_camera_frame"><pose>0 0 0 0 0 0</pose>
 <inertial><mass>0.001</mass><inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz></inertia></inertial>
 <sensor name="rgb" type="rgbd_camera"><gz_frame_id>oak_rgb_camera_optical_frame</gz_frame_id>
 <topic>/oak_sim/rgb</topic><update_rate>15</update_rate><always_on>true</always_on>
 <camera><camera_info_topic>/oak_sim/rgb/camera_info</camera_info_topic><horizontal_fov>1.204</horizontal_fov>
 <image><width>640</width><height>400</height><format>R8G8B8</format></image>
 <clip><near>0.1</near><far>10</far></clip>
 <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise></camera></sensor></link>
 <joint name="rgb_joint" type="fixed"><parent>oak</parent><child>oak_rgb_camera_frame</child></joint>
<link name="oak_left_camera_frame"><pose>0 0.0375 0 0 0 0</pose>
 <inertial><mass>0.001</mass><inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz></inertia></inertial>
 <sensor name="left" type="camera"><gz_frame_id>oak_left_camera_optical_frame</gz_frame_id>
 <topic>/oak_sim/left</topic><update_rate>15</update_rate><always_on>true</always_on>
 <camera><camera_info_topic>/oak_sim/left/camera_info</camera_info_topic><horizontal_fov>1.2740903539558606</horizontal_fov>
 <image><width>640</width><height>480</height><format>L8</format></image>
 <clip><near>0.1</near><far>10</far></clip>
 <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise></camera></sensor></link>
 <joint name="left_joint" type="fixed"><parent>oak</parent><child>oak_left_camera_frame</child></joint>
<link name="oak_right_camera_frame"><pose>0 -0.0375 0 0 0 0</pose>
 <inertial><mass>0.001</mass><inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz></inertia></inertial>
 <sensor name="right" type="camera"><gz_frame_id>oak_right_camera_optical_frame</gz_frame_id>
 <topic>/oak_sim/right</topic><update_rate>15</update_rate><always_on>true</always_on>
 <camera><camera_info_topic>/oak_sim/right/camera_info</camera_info_topic><horizontal_fov>1.2740903539558606</horizontal_fov>
 <image><width>640</width><height>480</height><format>L8</format></image>
 <clip><near>0.1</near><far>10</far></clip>
 <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise></camera></sensor></link>
 <joint name="right_joint" type="fixed"><parent>oak</parent><child>oak_right_camera_frame</child></joint>
<link name="oak_imu_frame"><inertial><mass>0.0001</mass><inertia><ixx>1e-8</ixx><iyy>1e-8</iyy><izz>1e-8</izz></inertia></inertial><sensor name="imu" type="imu"><gz_frame_id>oak_imu_frame</gz_frame_id><topic>/oak/imu/data</topic><update_rate>100</update_rate><always_on>true</always_on><imu>
<angular_velocity>
<x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
<y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
<z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
</angular_velocity>
<linear_acceleration>
<x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
<y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
<z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
</linear_acceleration>
</imu></sensor></link><joint name="imu_joint" type="fixed"><parent>oak</parent><child>oak_imu_frame</child></joint></model></sdf>