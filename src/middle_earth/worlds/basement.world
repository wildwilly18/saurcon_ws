<?xml version="1.0"?>
<sdf version="1.6">
  <world name="basement">
    
    <!-- Physics -->
    <physics name="10ms" type="dart">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
      <start_paused>false</start_paused>
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <!-- Lighting -->
    <scene>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <background>0.3 0.3 0.3 1.0</background>
    </scene>

    <!-- Light from North -->
    <light type="directional" name="sun_north">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 1 -1</direction>
    </light>

    <!-- Light from South -->
    <light type="directional" name="sun_south">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 -1 -1</direction>
    </light>

    <!-- Light from East -->
    <light type="directional" name="sun_east">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>1 0 -1</direction>
    </light>

    <!-- Light from West -->
    <light type="directional" name="sun_west">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-1 0 -1</direction>
    </light>

    <!-- Basement floor (10m x 12m - larger driving area) -->
    <model name="basement_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12.0 10.0 0.01</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.0 10.0 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.1 1</ambient>
            <diffuse>0.6 0.3 0.15 1</diffuse>
            <specular>0.3 0.15 0.1 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>


    <!-- Include RC Ackermann Vehicle -->
    <include>
      <uri>model://rc_ackermann_vehicle</uri>
      <name>rc_vehicle</name>
      <pose>-1.0000 -3.5000 0.05 0 0 0</pose>
    </include>

    <!-- ArUco Markers in oval pattern at 12" (0.3048m) height -->
    <!-- 12 markers evenly spaced like clock positions -->
    
    <!-- Marker 0 -->
    <model name="aruco_0">
      <static>true</static>
      <pose>-0.0000 -3.5000 0.3048 0 0 3.1416</pose>
      <link name="marker_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.001 0.1524 0.1524</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://materials/textures/aruco_0.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
    
