<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>saurcon_rl</name>
  <version>0.1.0</version>
  <description>Reinforcement-learning racing policy for SAURCON: fast training environment, PPO training, and a ROS 2 node that drives the car.</description>
  <maintainer email="wilson.lysford@gmail.com">wilson</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>saurcon_rc</exec_depend>
  <exec_depend>saurcon_nav</exec_depend>
  <!-- torch, stable-baselines3 and gymnasium come from the .venv-rl virtual
       environment created by scripts/setup.sh, not from rosdep. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
