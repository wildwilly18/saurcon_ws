<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>saurcon_rl</name>
  <version>0.1.0</version>
  <description>Reinforcement learning for SAURCON in simulation: bicycle and MuJoCo environments (map-based and cone-vision), PPO training, MuJoCo validation drives and system identification. No ROS nodes; the driving stack's planner is saurcon_plan.</description>
  <maintainer email="wilson.lysford@gmail.com">wilson</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>saurcon_plan</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- torch, stable-baselines3, gymnasium and mujoco come from the .venv-rl virtual
       environment created by scripts/setup.sh, not from rosdep. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
