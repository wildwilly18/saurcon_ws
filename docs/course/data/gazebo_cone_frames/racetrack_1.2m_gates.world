<?xml version="1.0"?>
<sdf version="1.6">
  <world name="warehouse_racetrack">
    
    <!-- Physics -->
    <physics name="10ms" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <!-- Scene settings -->
    <scene>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <background>0.3 0.3 0.3 1.0</background>
      <render_engine>ogre2</render_engine>
    </scene>

    <!-- Primary overhead light -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>0.0 0.0 -1</direction>
      <intensity>3.0</intensity>
    </light>

    <!-- Fill light from front to prevent marker face shadows -->
    <light type="directional" name="fill_front">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.0 1.0 -0.2</direction>
      <intensity>2.0</intensity>
    </light>

    <!-- Fill light from back -->
    <light type="directional" name="fill_back">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.0 -1.0 -0.2</direction>
      <intensity>2.0</intensity>
    </light>

    <!-- Ground plane - provides clean flat collision surface for RC car -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Distribution Warehouse from Gazebo Fuel -->
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Distribution_Warehouse</uri>
      <name>warehouse</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Pallet Rack Hallways - Rows run North-South, 5 rows creating 4 aisles -->
    
    <!-- Row A at y=-10 (south edge, facing north) -->
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pallet_Rack</uri>
      <name>rack_a1</name>
      <pose>-10 -10 0 0 0 0</pose>
    </include>
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pallet_Rack</uri>
      <name>rack_a2</name>
      <pose>-6 -10 0 0 0 0</pose>
    </include>
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pallet_Rack</uri>
      <name>rack_a3</name>
      <pose>-2 -10 0 0 0 0</pose>
    </include>
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pallet_Rack</uri>
      <name>rack_a4</name>
      <pose>2 -10 0 0 0 0</pose>
    </include>
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pallet_Rack</uri>
      <name>rack_a5</name>
      <pose>6 -10 0 0 0 0</pose>
    </include>

    <!-- Row B at y=-6 (facing south toward Row A, creates Aisle 1) -->
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pallet_Rack</uri>
      <name>rack_b1</name>
      <pose>-10 -6 0 0 0 3.14159</pose>
    </include>
    <include>
      <static>true</static>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pallet_Rack</uri>
